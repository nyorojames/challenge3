# Copy to .env and adjust. Never commit .env.

PORT=4000
# Matches docker-compose.yml. For a local install, use your own user/password.
DATABASE_URL=postgres://duka:duka@localhost:5432/duka_ledger
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
TIMEZONE=Africa/Nairobi

# AI parser: rules | gemini | ollama  (rules needs no internet and never fails)
AI_PROVIDER=rules
AI_TIMEOUT_MS=5000
# Free key from https://aistudio.google.com/apikey (only needed for AI_PROVIDER=gemini)
GEMINI_API_KEY=
# A "-latest" alias never gets retired. Flash-Lite answered in ~1 s on the free tier when
# the bigger Flash models were busy (HTTP 503) or out of quota (429).
LLM_MODEL=gemini-flash-lite-latest
# Only needed for AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Only mock providers exist; real Daraja / Africa's Talking adapters are future work.
PAYMENT_PROVIDER=mock
SMS_PROVIDER=mock
